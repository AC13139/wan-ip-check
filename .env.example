# =============================================================================
# wan-ip-check v2 Configuration
# =============================================================================
# On first run, these env vars are migrated into the SQLite database.
# After that, the database is the source of truth — configure via Web UI.
# These vars are only read again if the database is empty (fresh install/reset).

# === Infrastructure (always read from env, not stored in DB) ===
PORT=7373
DATA_DIR=./data
DISCORD_PROXY=http://192.168.x.x:port

# === Legacy Migration (read on first run only) ===
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
IP_CHECK_SERVICE=https://icanhazip.com
CRON_SCHEDULE=*/5 * * * *
DAILY_SUMMARY_TIME=2000
TIMEZONE=Asia/Shanghai

# === Cloudflare (optional — creates actions on first run) ===
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-zone-id
CF_DNS_RECORD_IDS=record_id_1,record_id_2
CF_ACCOUNT_ID=your-account-id
CF_LOCATION_ID=your-gateway-location-id

# === Encryption (optional — auto-generated if unset) ===
# ENCRYPTION_KEY=hex-encoded-32-byte-key

# === PBR Routing (advanced — only for multi-gateway Docker setups) ===
# NOTIFICATION_INTERFACE=eth1
# PBR_GATEWAY=192.168.10.1
# PBR_DEV=eth1
# PBR_TABLE=10
